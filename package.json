{
  "private": true,
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint $(git ls-files)",
    "lint:ci": "oxlint --format=github $(git ls-files)",
    "lint:fix": "oxlint --fix $(git ls-files)",
    "build": "pnpm -r --filter='./packages/*' run build",
    "test": "pnpm -r --workspace-concurrency=1 --if-present run test:run",
    "dev": "pnpm -r --parallel --filter='./packages/*' run dev"
  },
  "devDependencies": {
    "@types/node": "^22.16.3",
    "@vitejs/release-scripts": "^1.6.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.13.1",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
