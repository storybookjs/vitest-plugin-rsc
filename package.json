{
  "private": true,
  "type": "module",
  "scripts": {
    "format": "oxfmt $(git ls-files ':!:public/mockServiceWorker.js')",
    "format:check": "oxfmt --check $(git ls-files ':!:public/mockServiceWorker.js')",
    "lint": "oxlint $(git ls-files)",
    "lint:ci": "oxlint --format=github $(git ls-files)",
    "lint:fix": "oxlint --fix $(git ls-files)",
    "tsgo": "tsgo --build",
    "build": "pnpm -r --filter='./packages/*' run build",
    "test": "pnpm test:run",
    "test:run": "NODE_OPTIONS='--conditions=vitest-plugin-rsc-source' vitest run --configLoader native",
    "test:watch": "NODE_OPTIONS='--conditions=vitest-plugin-rsc-source' vitest --configLoader native",
    "test:dist": "vitest run --configLoader runner",
    "perf": "pnpm perf:commands",
    "perf:ci": "pnpm perf",
    "perf:commands": "node scripts/perf/run-command-benchmarks.ts",
    "perf:micro": "node scripts/perf/run-vitest-bench.ts",
    "dev": "pnpm -r --parallel --filter='./packages/*' run dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@typescript/native-preview": "7.0.0-dev.20260512.1",
    "@vitest/browser": "5.0.0-beta.2",
    "@vitest/browser-playwright": "5.0.0-beta.2",
    "@vitest/coverage-v8": "5.0.0-beta.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "oxlint-tsgolint": "^0.22.1",
    "playwright": "^1.60.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.12",
    "vitest": "5.0.0-beta.2",
    "vitest-plugin-rsc": "workspace:*"
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.0.8",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
