{
  "name": "vitest-plugin-rsc",
  "version": "0.3.0",
  "description": "Test React Server Components and Next.js App Router apps in Vitest Browser Mode.",
  "keywords": [
    "nextjs",
    "react",
    "react-server-components",
    "rsc",
    "vite",
    "vitest"
  ],
  "homepage": "https://github.com/storybookjs/vitest-plugin-rsc#readme",
  "bugs": {
    "url": "https://github.com/storybookjs/vitest-plugin-rsc/issues"
  },
  "license": "MIT",
  "author": "Kasper Peulen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storybookjs/vitest-plugin-rsc.git",
    "directory": "packages/vitest-plugin-rsc"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "vitest-plugin-rsc-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./async-hooks": {
      "types": "./dist/async-hooks.d.ts",
      "vitest-plugin-rsc-source": "./src/async-hooks.ts",
      "default": "./dist/async-hooks.js"
    },
    "./testing-library": {
      "types": "./dist/testing-library.d.ts",
      "vitest-plugin-rsc-source": "./src/testing-library.tsx",
      "default": "./dist/testing-library.js"
    },
    "./testing-library-client": {
      "types": "./dist/testing-library-client.d.ts",
      "vitest-plugin-rsc-source": "./src/testing-library-client.tsx",
      "default": "./dist/testing-library-client.js"
    },
    "./nextjs/testing-library": {
      "types": "./dist/nextjs/index.d.ts",
      "vitest-plugin-rsc-source": "./src/nextjs/index.ts",
      "default": "./dist/nextjs/index.js"
    },
    "./nextjs/client-components": {
      "types": "./dist/nextjs/client-components.d.ts",
      "vitest-plugin-rsc-source": "./src/nextjs/client-components.ts",
      "default": "./dist/nextjs/client-components.js"
    },
    "./nextjs/plugin": {
      "types": "./dist/nextjs/plugin.d.ts",
      "vitest-plugin-rsc-source": "./src/nextjs/plugin.ts",
      "default": "./dist/nextjs/plugin.js"
    },
    "./node/*": "./dist/node/*.js",
    "./nextjs/rsc": {
      "types": "./dist/nextjs/rsc.d.ts",
      "vitest-plugin-rsc-source": "./src/nextjs/rsc.ts",
      "default": "./dist/nextjs/rsc.js"
    },
    "./nextjs/ssr": {
      "types": "./dist/nextjs/ssr.d.ts",
      "vitest-plugin-rsc-source": "./src/nextjs/ssr.ts",
      "default": "./dist/nextjs/ssr.js"
    },
    "./nextjs/client": {
      "types": "./dist/nextjs/client.d.ts",
      "vitest-plugin-rsc-source": "./src/nextjs/client.tsx",
      "default": "./dist/nextjs/client.js"
    },
    "./nextjs/node-rendered": {
      "types": "./dist/nextjs/node-rendered.d.ts",
      "vitest-plugin-rsc-source": "./src/nextjs/node-rendered.tsx",
      "default": "./dist/nextjs/node-rendered.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "dev": "tsdown --sourcemap --watch src",
    "build": "tsdown",
    "prepack": "tsdown && node scripts/readme.ts",
    "generate": "node scripts/node-modules.ts"
  },
  "dependencies": {
    "@jridgewell/gen-mapping": "^0.3.13",
    "@vitejs/plugin-rsc": "0.5.36",
    "cjs-module-lexer": "^2.3.0",
    "convert-source-map": "^2.0.0",
    "magic-string": "^0.30.21"
  },
  "devDependencies": {
    "@next/routing": "16.4.0",
    "@noble/hashes": "2.4.0",
    "@types/convert-source-map": "^2.0.3",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "assert": "2.1.0",
    "events": "3.3.0",
    "fflate": "0.8.3",
    "memfs": "4.80.0",
    "next": "16.4.0",
    "node-inspect-extracted": "3.3.4",
    "path-browserify": "1.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "readable-stream": "4.8.0",
    "rolldown": "^1.0.0",
    "string_decoder": "1.3.0",
    "tsdown": "^0.22.0",
    "unenv": "2.0.0-rc.24",
    "util": "0.12.5",
    "vite": "^8.3.1"
  },
  "peerDependencies": {
    "@next/routing": ">=16.4.0-0",
    "next": ">=16.4.0-0",
    "react": "*",
    "react-dom": "*",
    "vite": ">=8.0.0",
    "vitest": "*"
  },
  "peerDependenciesMeta": {
    "@next/routing": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "//": "Not API, and they change with any version: ./nextjs/rsc, ./nextjs/ssr, ./nextjs/client and ./nextjs/node-rendered are modules that the layers of the plugin import by these ids, and ./node/* are the modules of Node.js that the server layers get for node:<name>."
}
