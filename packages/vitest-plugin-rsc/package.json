{
  "name": "vitest-plugin-rsc",
  "version": "0.1.1",
  "description": "React Server Components (RSC) support for Vitest.",
  "keywords": [
    "react",
    "react-server-components",
    "rsc",
    "vite"
  ],
  "homepage": "https://github.com/storybookjs/vitest-plugin-rsc#readme",
  "bugs": {
    "url": "https://github.com/storybookjs/vitest-plugin-rsc/issues"
  },
  "license": "MIT",
  "author": "Kasper Peulen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storybookjs/vitest-plugin-rsc.git",
    "directory": "packages/vitest-plugin-rsc"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./dist/nextjs/navigation": {
      "react-server": "./dist/nextjs/navigation.react-server.js",
      "default": "./dist/nextjs/navigation.js"
    },
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "dev": "tsdown --sourcemap --watch src",
    "build": "tsdown",
    "prepack": "tsdown"
  },
  "dependencies": {
    "@jridgewell/gen-mapping": "^0.3.13",
    "@vitejs/plugin-rsc": "0.5.26",
    "@vitest/expect": "5.0.0-beta.2",
    "@vitest/spy": "5.0.0-beta.2",
    "convert-source-map": "^2.0.0"
  },
  "devDependencies": {
    "@types/estree": "^1.0.9",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "msw": "^2.14.5",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rolldown": "^1.0.0",
    "tsdown": "^0.22.0",
    "vite": "^8.0.11"
  },
  "peerDependencies": {
    "msw": "^2",
    "next": "*",
    "react": "*",
    "react-dom": "*",
    "vite": "*"
  },
  "peerDependenciesMeta": {
    "msw": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  }
}
