{
  "name": "vitest-plugin-rsc",
  "version": "0.0.0-experimental-9f1f65ef-20250807",
  "description": "React Server Components (RSC) support for Vitest.",
  "keywords": [
    "react",
    "react-server-components",
    "rsc",
    "vite"
  ],
  "license": "MIT",
  "author": "Kasper Peulen",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#navigation": {
      "react-server": "./test/navigation.react-server.ts",
      "default": "./test/navigation.ts"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    "./dist/nextjs/navigation": {
      "react-server": "./dist/nextjs/navigation.react-server.js",
      "default": "./dist/nextjs/navigation.js"
    },
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "dev": "tsdown --sourcemap --watch src",
    "build": "tsdown",
    "prepack": "tsdown",
    "publish": "npm publish --tag experimental"
  },
  "dependencies": {
    "@vitejs/plugin-rsc": "0.5.24",
    "@vitest/expect": "5.0.0-beta.2",
    "@vitest/spy": "5.0.0-beta.2"
  },
  "devDependencies": {
    "@types/estree": "^1.0.8",
    "@types/node": "^24.12.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "next": "^15.4.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rolldown": "^1.0.0",
    "tsdown": "^0.22.0",
    "vite": "^8.0.11"
  },
  "peerDependencies": {
    "next": "*",
    "react": "*",
    "react-dom": "*",
    "vite": "*"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
