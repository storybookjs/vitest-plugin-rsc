{
  "name": "vitest-plugin-rsc",
  "version": "0.2.2",
  "description": "React Server Components (RSC) support for Vitest.",
  "keywords": [
    "react",
    "react-server-components",
    "rsc",
    "vite"
  ],
  "homepage": "https://github.com/storybookjs/vitest-plugin-rsc#readme",
  "bugs": {
    "url": "https://github.com/storybookjs/vitest-plugin-rsc/issues"
  },
  "license": "MIT",
  "author": "Kasper Peulen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storybookjs/vitest-plugin-rsc.git",
    "directory": "packages/vitest-plugin-rsc"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "vitest-plugin-rsc-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./async-hooks": {
      "types": "./dist/async-hooks.d.ts",
      "vitest-plugin-rsc-source": "./src/async-hooks.ts",
      "default": "./dist/async-hooks.js"
    },
    "./async-local-storage": {
      "types": "./dist/async-local-storage.d.ts",
      "vitest-plugin-rsc-source": "./src/async-local-storage.ts",
      "default": "./dist/async-local-storage.js"
    },
    "./testing-library": {
      "types": "./dist/testing-library.d.ts",
      "vitest-plugin-rsc-source": "./src/testing-library.tsx",
      "default": "./dist/testing-library.js"
    },
    "./testing-library-client": {
      "types": "./dist/testing-library-client.d.ts",
      "vitest-plugin-rsc-source": "./src/testing-library-client.tsx",
      "default": "./dist/testing-library-client.js"
    },
    "./nextjs/client": {
      "types": "./dist/nextjs/client.d.ts",
      "vitest-plugin-rsc-source": "./src/nextjs/client.tsx",
      "default": "./dist/nextjs/client.js"
    },
    "./nextjs/testing-library-client": {
      "types": "./dist/nextjs/testing-library-client.d.ts",
      "vitest-plugin-rsc-source": "./src/nextjs/testing-library-client.ts",
      "default": "./dist/nextjs/testing-library-client.js"
    },
    "./nextjs/testing-library": {
      "types": "./dist/nextjs/testing-library.d.ts",
      "vitest-plugin-rsc-source": "./src/nextjs/testing-library.tsx",
      "default": "./dist/nextjs/testing-library.js"
    },
    "./nextjs/msw": {
      "types": "./dist/nextjs/msw.d.ts",
      "vitest-plugin-rsc-source": "./src/nextjs/msw.ts",
      "default": "./dist/nextjs/msw.js"
    },
    "./nextjs/os-browser": {
      "types": "./dist/nextjs/os-browser.d.ts",
      "vitest-plugin-rsc-source": "./src/nextjs/os-browser.ts",
      "default": "./dist/nextjs/os-browser.js"
    },
    "./nextjs/request-context": {
      "types": "./dist/nextjs/request-context.d.ts",
      "vitest-plugin-rsc-source": "./src/nextjs/request-context.ts",
      "default": "./dist/nextjs/request-context.js"
    },
    "./nextjs/plugin": {
      "types": "./dist/nextjs/plugin.d.ts",
      "vitest-plugin-rsc-source": "./src/nextjs/plugin.ts",
      "default": "./dist/nextjs/plugin.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "dev": "tsdown --sourcemap --watch src",
    "build": "tsdown",
    "prepack": "tsdown"
  },
  "dependencies": {
    "@jridgewell/gen-mapping": "^0.3.13",
    "@vitejs/plugin-rsc": "0.5.26",
    "@vitest/expect": "5.0.0-beta.2",
    "@vitest/spy": "5.0.0-beta.2",
    "convert-source-map": "^2.0.0"
  },
  "devDependencies": {
    "@types/convert-source-map": "^2.0.3",
    "@types/estree": "^1.0.9",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "msw": "^2.14.6",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rolldown": "^1.0.0",
    "tsdown": "^0.22.0",
    "vite": "^8.0.12"
  },
  "peerDependencies": {
    "msw": "^2",
    "next": "*",
    "react": "*",
    "react-dom": "*",
    "vite": "*"
  },
  "peerDependenciesMeta": {
    "msw": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  }
}
