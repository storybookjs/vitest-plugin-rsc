{
  "name": "@storybook/nextjs-vite-rsc",
  "version": "0.0.0",
  "description": "A Storybook framework for Next.js apps with React Server Components, on Vite and vitest-plugin-rsc.",
  "keywords": [
    "nextjs",
    "react",
    "react-server-components",
    "rsc",
    "storybook",
    "storybook-framework",
    "vite"
  ],
  "homepage": "https://github.com/storybookjs/vitest-plugin-rsc/tree/main/packages/storybook-nextjs-vite-rsc#readme",
  "bugs": {
    "url": "https://github.com/storybookjs/vitest-plugin-rsc/issues"
  },
  "license": "MIT",
  "author": "Kasper Peulen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storybookjs/vitest-plugin-rsc.git",
    "directory": "packages/storybook-nextjs-vite-rsc"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "storybook-nextjs-vite-rsc-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "storybook-nextjs-vite-rsc-source": "./src/preset.ts",
      "default": "./dist/preset.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "storybook-nextjs-vite-rsc-source": "./src/server.ts",
      "default": "./dist/server.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun --bun vitest --configLoader native",
    "test:run": "bun --bun vitest run --configLoader native",
    "dev": "bun --bun tsdown --sourcemap --watch src",
    "build": "bun --bun tsdown",
    "prepack": "tsdown"
  },
  "dependencies": {
    "@storybook/builder-vite": "https://pkg.pr.new/storybookjs/storybook/@storybook/builder-vite@d5523e646c9ffd61eddd2eec1efcbd12e428dce6",
    "@storybook/react": "https://pkg.pr.new/storybookjs/storybook/@storybook/react@d5523e646c9ffd61eddd2eec1efcbd12e428dce6"
  },
  "devDependencies": {
    "@storybook/addon-docs": "https://pkg.pr.new/storybookjs/storybook/@storybook/addon-docs@d5523e646c9ffd61eddd2eec1efcbd12e428dce6",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "next": "16.4.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "storybook": "https://pkg.pr.new/storybookjs/storybook/storybook@d5523e646c9ffd61eddd2eec1efcbd12e428dce6",
    "tsdown": "^0.22.0",
    "vite": "^8.3.1",
    "vitest-plugin-rsc": "workspace:*"
  },
  "peerDependencies": {
    "@storybook/addon-docs": "^11.0.0-0",
    "next": ">=16.4.0-0",
    "react": "*",
    "react-dom": "*",
    "storybook": "^11.0.0-0",
    "vite": ">=8.0.0",
    "vitest-plugin-rsc": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@storybook/addon-docs": {
      "optional": true
    }
  }
}
