{
  "compilerOptions": {
    "target": "ES2023",
    // The DOM for the code that the perf scripts run in a page of Playwright.
    "lib": ["DOM", "ES2023"],
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "module": "preserve",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // Node.js runs the scripts as they are written, with the types taken out.
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"]
}
