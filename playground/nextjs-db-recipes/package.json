{
  "name": "nextjs-db-recipes",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./*"
  },
  "scripts": {
    "dev": "next dev",
    "test": "vitest",
    "test:run": "vitest run",
    "postinstall": "prisma generate --config recipes/sqlite-prisma/prisma.config.ts && prisma generate --config recipes/mysql-prisma/prisma.config.ts && prisma generate --config recipes/postgres-prisma/prisma.config.ts",
    "db:generate": "drizzle-kit generate --config recipes/sqlite-drizzle/drizzle.config.ts && drizzle-kit generate --config recipes/mysql-drizzle/drizzle.config.ts && drizzle-kit generate --config recipes/postgres-drizzle/drizzle.config.ts"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@libsql/kysely-libsql": "^0.4.1",
    "@next/routing": "16.4.0",
    "@prisma/adapter-libsql": "7.10.1",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.11.1",
    "kysely": "^0.29.7",
    "mysql2": "^3.15.3",
    "next": "16.4.0",
    "pg": "^8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.5",
    "@libsql/client-wasm": "0.18.0",
    "@types/ioredis-mock": "^8.2.8",
    "@types/node": "^24.12.4",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser": "5.0.3",
    "@vitest/browser-playwright": "5.0.3",
    "drizzle-kit": "^0.31.10",
    "ioredis-mock": "8.13.1",
    "lite4mariadb": "0.1.2",
    "playwright": "^1.64.0",
    "prisma": "7.10.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "5.0.3",
    "vitest-plugin-rsc": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  }
}
