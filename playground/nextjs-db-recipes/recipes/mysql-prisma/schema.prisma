generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "mysql"
}

model Todo {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(200)
  done      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@map("todos")
}
