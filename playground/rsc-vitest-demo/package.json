{
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--conditions=vitest-plugin-rsc-source' vite --configLoader native",
    "build": "NODE_OPTIONS='--conditions=vitest-plugin-rsc-source' vite build --configLoader native",
    "check": "tsc -b",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:run:bun": "bun --bun vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vitest-plugin-rsc": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "msw": "^2.14.6",
    "playwright": "^1.64.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
