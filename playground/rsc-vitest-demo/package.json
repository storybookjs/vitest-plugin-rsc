{
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun --conditions=vitest-plugin-rsc-source node_modules/vite/bin/vite.js --configLoader native",
    "build": "bun --bun --conditions=vitest-plugin-rsc-source node_modules/vite/bin/vite.js build --configLoader native",
    "check": "tsc -b",
    "preview": "bun --bun vite preview --configLoader native",
    "test": "bun --bun vitest --configLoader native",
    "test:run": "bun --bun vitest run --configLoader native",
    "test:run:node": "vitest run --configLoader native",
    "test:coverage": "bun --bun vitest run --configLoader native --coverage",
    "test:watch": "bun --bun vitest watch --configLoader native"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vitest-plugin-rsc": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "msw": "^2.14.6",
    "playwright": "^1.64.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
