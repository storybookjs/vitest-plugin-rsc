    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "5.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-seed": "^0.3.1",
    "msw": "2.14.6",
    "playwright": "^1.64.0",
    "storybook": "https://pkg.pr.new/storybookjs/storybook/storybook@87cda8cbeb16071800271f2f9ef093ae60b2fb5c",
