{
  "name": "nextjs-notes-demo",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./lib/*",
    "#hooks/*": "./hooks/*",
    "#*": "./*"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest",
    "test:run": "vitest run",
    "test:update": "vitest run --project=nextjs-notes-demo-browser --update",
    "test:report": "vitest run --reporter=html",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "storybook": "NODE_OPTIONS='--conditions=vitest-plugin-rsc-source --conditions=storybook-nextjs-vite-rsc-source' storybook dev --port 6006",
    "build-storybook": "NODE_OPTIONS='--conditions=vitest-plugin-rsc-source --conditions=storybook-nextjs-vite-rsc-source' storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
