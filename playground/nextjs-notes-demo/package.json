    "@storybook/addon-docs": "https://pkg.pr.new/storybookjs/storybook/@storybook/addon-docs@87cda8cbeb16071800271f2f9ef093ae60b2fb5c",
    "@storybook/nextjs-vite-rsc": "workspace:*",
    "@tailwindcss/postcss": "^4.3.0",
