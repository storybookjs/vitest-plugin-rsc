# Optional. Defaults to an in-memory PGlite database when unset.
# Set DATABASE_URL to use a real Postgres/Neon database instead.
# DATABASE_URL="postgres://user:password@host/database?sslmode=require"
# DATABASE_URL_UNPOOLED="postgres://user:password@host/database?sslmode=require"

# Optional. A local development secret is used when unset.
# Use a stable 32+ character value when you want persistent auth sessions.
# BETTER_AUTH_SECRET="replace-with-at-least-32-characters"

# Optional. Enables real Better Auth email delivery through Resend.
# Without these, auth emails are logged in development.
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="Notes Demo <auth@example.com>"

# Optional seed scenario for the PGlite fallback.
# SCENARIO="notes-basic"
