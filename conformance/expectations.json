{
  "reasons": {
    "history-of-a-page-load": {
      "category": "plugin-bug",
      "text": "A page that the app loads itself, like a link to a path that is no route, replaces the entry of the history where a browser adds one. `back()` does not return to the page before it.",
      "match": "the history of this page has no entry to go to"
    },
    "action-to-no-route": {
      "category": "plugin-bug",
      "text": "A Server Action request to a path that is no route gets the not-found page, a 404. Next answers for the action: 400 or 409."
    },
    "route-handler-error-body": {
      "category": "plugin-bug",
      "text": "A route handler that throws is answered with the text `Internal Server Error`. `next start` sends a 500 without a body."
    },
    "global-css-stays": {
      "category": "plugin-bug",
      "text": "The global CSS of a page that an earlier test opened still applies. Vite adds a stylesheet once, and it outlives its page."
    },
    "not-found-noindex": {
      "category": "plugin-bug",
      "text": "The not-found page of a path that is no route has no `<meta name=\"robots\" content=\"noindex\">`."
    },
    "middleware": {
      "category": "not-yet",
      "text": "`middleware.ts` or `proxy.ts` does not run."
    },
    "config-routes": {
      "category": "not-yet",
      "text": "The redirects and rewrites of `next.config` do not apply."
    },
    "trailing-slash": {
      "category": "not-yet",
      "text": "`trailingSlash`: a URL is served as it is, without the redirect to its other form."
    },
    "pages-router": {
      "category": "not-yet",
      "text": "A page of the Pages Router. The plugin runs the routes of `app/`."
    },
    "interception-routes": {
      "category": "not-yet",
      "text": "An interception route, like `(.)test`. Next matches one with a rewrite, on the `Next-URL` header of a navigation."
    },
    "metadata-files": {
      "category": "not-yet",
      "text": "Metadata files: `favicon.ico`, `icon.png`, `opengraph-image`, `sitemap.ts`, `robots.txt`, `manifest.webmanifest`."
    },
    "font-preload": {
      "category": "not-yet",
      "text": "The `<link rel=\"preload\">` and `<link rel=\"preconnect\">` of `next/font`, which Next takes from a manifest of its build."
    },
    "react-development-build": {
      "category": "not-yet",
      "text": "A production build of React. The plugin runs React's development build: an error of the server reaches the client with its message, where production sends a digest and a minified message, and Strict Mode runs an effect twice."
    },
    "node-runtime": {
      "category": "not-yet",
      "text": "Server code that needs Node.js: a builtin module like `node:timers/promises`, or what Next's Node.js runtime does differently from its edge runtime. The server layers run on the edge runtime."
    },
    "server-action-ids": {
      "category": "not-yet",
      "text": "A request for a Server Action that is not there. The ids are Vite RSC's, so the server does not tell a malformed id (400) from an unknown one (409), and does not log Next's error for it."
    },
    "form-without-javascript": {
      "category": "not-yet",
      "text": "A form that the browser posts itself, not Next's router. The server does not look for the action in the form data."
    },
    "one-request-at-a-time": {
      "category": "not-yet",
      "text": "A navigation while a Server Action is in flight. The server handles one request at a time."
    },
    "another-origin": {
      "category": "not-yet",
      "text": "A redirect or a navigation to another origin. The tab cannot leave the test."
    },
    "javascript-off": {
      "category": "not-applicable",
      "text": "Opens the page with JavaScript off. The test runs in the tab of the page.",
      "match": "a page with JavaScript off"
    },
    "build-output": {
      "category": "not-applicable",
      "text": "Reads the output of `next build`: a manifest, a chunk or a prerendered file in `.next`.",
      "match": "the build output|a prerendered file|listClientChunks\\(\\)"
    },
    "cli-output": {
      "category": "not-applicable",
      "text": "Reads what `next build` prints: its table of routes."
    },
    "playwright-page": {
      "category": "not-applicable",
      "text": "Uses Playwright's `Page` itself: `page.route()` to stand in for a response, or an event of a frame.",
      "match": "of Playwright, in beforePageLoad"
    },
    "page-load-requests": {
      "category": "not-applicable",
      "text": "Counts the requests of a page load, a form post or a redirect. The shim sees what the page fetches, not what the plugin fetches to load a page."
    },
    "node-in-test": {
      "category": "not-applicable",
      "text": "The test itself needs Node.js: it starts a server, or removes a directory.",
      "match": "the test runs in a tab, not in Node\\.js|it starts a process, opens a socket or reads a build"
    },
    "shared-history": {
      "category": "not-applicable",
      "text": "Expects the `history.length` of a new tab. The tests of a file share the history of the tab, which ends at 50 entries."
    },
    "state-between-tests": {
      "category": "not-applicable",
      "text": "Expects the cookie that an earlier test of the file set. The plugin's `cleanup()` clears the cookies after every test."
    },
    "changes-the-app": {
      "category": "not-applicable",
      "text": "Changes a file of the app, or builds or starts the app itself.",
      "match": "needs a new build, or a dev server|runs the Next\\.js CLI itself"
    },
    "dev-overlay": {
      "category": "not-applicable",
      "text": "Reads Next's dev overlay, which only `next dev` has.",
      "match": "Next's dev overlay"
    }
  },
